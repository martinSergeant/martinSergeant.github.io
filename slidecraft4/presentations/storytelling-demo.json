{
  "$schema": "../presentation.schema.json",
  "schemaVersion": 1,
  "id": "sample-storytelling",
  "title": "A story in three beats",
  "transition": "zoom",
  "slides": [
    {
      "id": "begin",
      "title": "Begin with a question",
      "background": "#18211e",
      "elements": [
        {
          "id": "begin-label",
          "type": "text",
          "x": 8,
          "y": 18,
          "width": 50,
          "height": 6,
          "animation": "fade",
          "text": "A STORYTELLING DEMO",
          "fontSize": 1.25,
          "color": "#d3ee6b",
          "align": "left"
        },
        {
          "id": "begin-title",
          "type": "title",
          "x": 8,
          "y": 31,
          "width": 72,
          "height": 45,
          "animation": "rise",
          "text": "What if one small\nchange made a big\ndifference?",
          "fontSize": 5.2,
          "color": "#f5f4f0",
          "animationTrigger": "onKeyPress",
          "animationOrder": 1
        },
        {
          "id": "begin-shape",
          "type": "shape",
          "x": 82,
          "y": 20,
          "width": 14,
          "height": 25,
          "animation": "pop",
          "fill": "#d3ee6b",
          "shape": "circle",
          "animationTrigger": "onKeyPress",
          "animationOrder": 2
        }
      ]
    },
    {
      "id": "explore",
      "title": "Explore the idea",
      "background": "#f1eee5",
      "elements": [
        {
          "id": "explore-title",
          "type": "title",
          "x": 8,
          "y": 13,
          "width": 78,
          "height": 19,
          "animation": "rise",
          "text": "Make the idea tangible",
          "fontSize": 5.1,
          "color": "#1d2923"
        },
        {
          "id": "explore-list",
          "type": "text",
          "x": 10,
          "y": 42,
          "width": 72,
          "height": 38,
          "animation": "fade",
          "text": "Notice one point of friction\nTry one small improvement\nListen to what changes",
          "fontSize": 2.3,
          "color": "#526057",
          "align": "left",
          "bulletMarker": "disc",
          "revealItemsOnKeyPress": true
        }
      ]
    },
    {
      "id": "close",
      "title": "Close with a takeaway",
      "background": "#d3ee6b",
      "elements": [
        {
          "id": "close-kicker",
          "type": "text",
          "x": 8,
          "y": 18,
          "width": 50,
          "height": 6,
          "animation": "fade",
          "text": "THE TAKEAWAY",
          "fontSize": 1.25,
          "color": "#39493e",
          "align": "left"
        },
        {
          "id": "close-title",
          "type": "title",
          "x": 8,
          "y": 32,
          "width": 76,
          "height": 32,
          "animation": "rise",
          "text": "Small steps\ncan move a story forward.",
          "fontSize": 6,
          "color": "#1d2923"
        },
        {
          "id": "close-shape",
          "type": "shape",
          "x": 82,
          "y": 70,
          "width": 9,
          "height": 16,
          "animation": "slide",
          "fill": "#39493e",
          "shape": "circle"
        }
      ]
    }
  ]
}
